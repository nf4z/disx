{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "disx",
  "main": "./cloudflare/index.js",
  "compatibility_date": "2026-10-02",
  "vars": {
    "DOMAIN": "larplite.xyz"
  },
  "containers": [
    {
      "class_name": "DisxContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DISX_CONTAINER",
        "class_name": "DisxContainer"
      }
    ]
  },
  "exports": {
    "DisxContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
